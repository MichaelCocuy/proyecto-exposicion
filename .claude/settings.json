{
  "agent": "qa-playwright",
  "enabledMcpjsonServers": [
    "playwright"
  ],
  "permissions": {
    "allow": [
      "mcp__playwright",
      "Edit(./app/src/**)",
      "Edit(./tests/**)",
      "Bash(npx playwright test:*)",
      "Bash(curl -s localhost:3000/api/estado)",
      "Bash(curl -s http://localhost:3000/api/estado)",
      "Bash(git diff:*)",
      "Bash(git stash:*)",
      "Edit(./reportes/**)"
    ],
    "deny": [
      "Read(./juez/**)",
      "Edit(./juez/**)",
      "Read(./.bomba/**)",
      "Edit(./.bomba/**)",
      "Edit(./server.js)"
    ],
    "ask": [
      "mcp__playwright__browser_run_code_unsafe"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep|Glob|mcp__playwright__browser_run_code_unsafe",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/proteger-juez.mjs\""
          }
        ]
      }
    ]
  }
}
